rules_version = '2';

// Single-tenant accounting app for nipponnites.
// All data belongs to ONE owner. After the owner signs up once, put their
// Firebase Auth UID into OWNER_UID below and redeploy (`firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerUid() {
      return 'cFfEL9tWcFQ8aCr8l9HMq0TYcc63';
    }

    function isOwner() {
      return request.auth != null && request.auth.uid == ownerUid();
    }

    // Secrets (Shopify token, Resend key, ...) are written/read only by Cloud Functions
    // via the Admin SDK, which bypasses these rules. Clients get nothing.
    match /secrets/{doc=**} {
      allow read, write: if false;
    }

    // Append-only audit log: clients may read, only Functions may write.
    match /auditLog/{entry} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    // Everything else: full access for the owner only.
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
