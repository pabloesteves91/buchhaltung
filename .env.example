# Copy to .env.local and fill in from the Firebase console
# (Project settings > General > Your apps > SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=nipponnites-buchhaltung.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nipponnites-buchhaltung
VITE_FIREBASE_STORAGE_BUCKET=nipponnites-buchhaltung.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "1" to talk to the local Firebase Emulator Suite instead of the cloud project.
VITE_USE_EMULATORS=0
